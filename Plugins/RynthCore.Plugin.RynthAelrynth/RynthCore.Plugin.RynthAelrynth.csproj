<Project Sdk="Microsoft.NET.Sdk">

  <!-- RynthAelrynth: the Aelrynth server plugin. "aelrynth" is one of RynthCore's built-in server ids, so the
       engine's own Aelrynth detection decides when it is active (the hosts here only pick it at load).
       The build is shared (..\Shared\ServerPack\ServerPlugin.props); ServerData.cs holds what is known.
       Aelrynth's own features (AelrynthPlugin.cs, Aelrynth\) came from RynthOracle and RynthInventory on
       2026-10-20: the /top leaderboards and /trial records (a page of the Mini Remote's Server section),
       and the account vault (/mule-data), handed to RynthInventory's Global Inventory. Since 2026-10-21 it also
       publishes the difficulty tier where the player stands (Aelrynth\AelrynthDifficulty.cs: PropertyInt 9051),
       which RynthAi read itself before; RynthAi now reads it from the server plugin's profile values. Also since
       2026-10-21: Aelrynth's quest pack (Resources\quests.aelrynth.csv, generated by Tools\RynthOracle.QuestPackGen),
       moved from RynthOracle and offered back to it through "RynthServer.QuestPack" (ServerPlugin.props embeds it).
       Hosts: the IP too, as the engine's own detection has it (AelrynthWire.AelrynthIp). A client launched with the IP
       otherwise loaded this plugin only once the world name came at login, and never after an engine hot reload. -->
  <PropertyGroup>
    <AssemblyName>RynthCore.Plugin.RynthAelrynth</AssemblyName>
    <Version>0.2.0</Version>
    <RynthPluginServerId>aelrynth</RynthPluginServerId>
    <RynthPluginServerName>Aelrynth</RynthPluginServerName>
    <RynthPluginServerHosts>aelrynth.com|144.217.84.148</RynthPluginServerHosts>
    <RynthPluginServerWorldNames>Aelrynth*|Aeshnidae*</RynthPluginServerWorldNames>
    <RynthPluginDescription>Aelrynth only: the server card (its mods, links, account setup), Aelrynth's leaderboards and Trials records in the Mini Remote, the account vault in Global Inventory, the difficulty tier for RynthAi, and Aelrynth's quests in RynthOracle.</RynthPluginDescription>
  </PropertyGroup>

  <Import Project="..\Shared\ServerPack\ServerPlugin.props" />

  <ItemGroup>
    <None Include="THIRD_PARTY_NOTICES.md" CopyToPublishDirectory="PreserveNewest" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The vault's server lines vs a player's copy of them, and the storage feed RynthInventory reads. -->
    <Compile Include="$(RynthSuiteRoot)Plugins\Shared\ChatSource.cs" Link="Shared\ChatSource.cs" />
    <Compile Include="$(RynthSuiteRoot)Plugins\Shared\StorageFeed.cs" Link="Shared\StorageFeed.cs" />
  </ItemGroup>

</Project>
